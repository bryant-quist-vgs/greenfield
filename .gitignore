# Ignore rules for greenfield: shell scripts, Markdown, and a template directory.
#
# Tracked, and never to be ignored: everything under template/, backlog/, and
# .agent_notes/; VERSION; .llm-size-guard-state.json. template/.gitignore is the ignore
# file placed in new repositories; it also applies inside template/ here, and nothing the
# template ships matches it.

# Throwaway files of the Makefile gates (`make llm-size-guard` keeps its throwaway Git
# index in .gate-scratch/), and scratch output of local commands (local/).
/.gate-scratch/
/local/

# Local secrets and environment files. Ignoring a file is not a security control.
.env
.env.*
!.env.example
*.pem
*.p12
*.key
/.netrc

# macOS
.DS_Store
.AppleDouble
.LSOverride
._*
.DocumentRevisions-V100
.fseventsd
.Spotlight-V100
.TemporaryItems
.Trashes
.VolumeIcon.icns
.com.apple.timemachine.donotpresent
.AppleDB
.AppleDesktop
.apdisk
*.icloud

# Editors
/.idea/
/.vscode/
*.swp
*.swo
*~
.\#*
\#*\#

# Agent tooling: local, per-user state only.
/.claude/settings.local.json
/.claude/worktrees/
/.claude/.cc-writes/
